{
  "name": "hilbert-chart-3d",
  "version": "0.4.0",
  "description": "A 3d hilbert space-filling curve D3 chart for representing one-dimensional lengths on a three-dimensional space.",
  "type": "module",
  "jsdelivr": "dist/hilbert-chart-3d.min.js",
  "unpkg": "dist/hilbert-chart-3d.min.js",
  "main": "dist/hilbert-chart-3d.mjs",
  "module": "dist/hilbert-chart-3d.mjs",
  "types": "dist/hilbert-chart-3d.d.ts",
  "exports": {
    "types": "./dist/hilbert-chart-3d.d.ts",
    "umd": "./dist/hilbert-chart-3d.min.js",
    "default": "./dist/hilbert-chart-3d.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vasturiano/hilbert-chart-3d.git"
  },
  "homepage": "https://github.com/vasturiano/hilbert-chart-3d",
  "keywords": [
    "hilbert",
    "space filling",
    "curve",
    "3d",
    "chart"
  ],
  "author": {
    "name": "Vasco Asturiano",
    "url": "https://github.com/vasturiano"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasturiano/hilbert-chart-3d/issues"
  },
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "dev": "rollup -w -c rollup.config.dev.js",
    "prepare": "npm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "dependencies": {
    "accessor-fn": "1",
    "kapsule": "^1.16",
    "three": ">=0.179 <1",
    "three-hilbert": "*",
    "three-render-objects": "^1.44"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@typescript/typescript6": "^6.0.2",
    "postcss": "^8.5.32",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.0",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=12"
  }
}
